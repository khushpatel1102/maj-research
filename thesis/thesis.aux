\newlabel{fig:poison}{{5.7}{37}{Accuracy as a function of the memory poisoning rate, under the corrected, audited harness, with Wilson 95\% confidence interval bands. Neither mode shows a significant downward trend as the corruption rate rises}{figure.5.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces Reliability harness results: stochastic stability, label-flip discrimination, and the defense filter under 50\% poisoned memory.}}{37}{figure.5.8}\protected@file@percent }
